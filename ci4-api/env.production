# CodeIgniter 4 - Production Environment
CI_ENVIRONMENT = production

# Application - Domain adresinizi yazın
app.baseURL = 'https://yourdomain.com/'

# Database - Plesk MySQL bilgilerinizi yazın
database.default.hostname = localhost
database.default.database = veritabani_adi
database.default.username = veritabani_kullanici
database.default.password = veritabani_sifre
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# JWT - Güvenli bir secret key oluşturun
JWT_SECRET = buraya-guclu-bir-secret-yazin-en-az-32-karakter

# CORS - Frontend domain adresiniz
CORS_ORIGIN = https://yourdomain.com

# Upload
UPLOAD_MAX_SIZE = 10485760
